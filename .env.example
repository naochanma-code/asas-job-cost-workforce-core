# Set locally; never commit values. LINE remains disabled by default.
DATABASE_URL=
# Runtime password entered directly in secret manager when URL has no password.
PGPASSWORD=
# Public PostgreSQL root CA PEM (not a private key); required for Railway trust.
DATABASE_SSL_CA=
# Operator migration command only; never set on API runtime.
# Existing secured installation: MIGRATION_ROLE=asas_m1_migrator
MIGRATION_ROLE=
LOCAL_DB_DIR=
WEB_ORIGIN=
API_URL=
HOST=
PORT=
BOOTSTRAP_USERNAME=
BOOTSTRAP_PASSWORD=
LINE_ENABLED=
# Temporary OWNER-only enrollment; business LINE must remain disabled.
LINE_ENROLLMENT_ENABLED=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_BOT_ID=
LINE_PAYLOAD_KEY=
LINE_TEST_USER_IDS=
LINE_TEST_GROUP_IDS=
# Exact synthetic project UUIDs; empty denies every project on LINE, including OWNER.
LINE_TEST_PROJECT_IDS=

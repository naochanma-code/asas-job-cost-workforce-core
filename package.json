{
  "name": "asas-foundation",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx apps/api/src/main.ts",
    "dev:web": "next dev apps/web --hostname 127.0.0.1 --port 3000",
    "build": "next build apps/web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "migrate": "tsx scripts/migrate.ts",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "worker": "tsx scripts/worker.ts",
    "backup": "tsx scripts/backup.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "fastify": "5.12.5",
    "next": "16.3.5",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prettier": "3.8.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.19.0"
}
